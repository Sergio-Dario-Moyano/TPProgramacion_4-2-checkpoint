
{
  "name": "utn-bugs-root",
  "version": "1.0.0",
  "description": "Workspace de UTN-BUGS con frontend Angular y backend NestJS",
  "private": true,
  "scripts": {
    "start:back": "npm --prefix backend run start:dev",
    "start:front": "npm --prefix frontend run start",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"magenta,cyan\" \"npm run start:back\" \"npm run start:front\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}